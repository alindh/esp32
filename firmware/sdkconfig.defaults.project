# Project overlay, applied on top of ESP-IDF's examples/openthread/ot_rcp/sdkconfig.defaults.
# Keep this minimal and commented. Every line is a deliberate deviation or pin.

# Byte-identical output for identical inputs: no timestamps or absolute paths baked in.
CONFIG_APP_REPRODUCIBLE_BUILD=y

# Host transport: UART0 via the onboard CH343 bridge (decided 2026-09-26, docs/rcp-transport.md).
# This is the example's default, pinned explicitly. The link parameters are constants in
# ot_rcp/main/esp_ot_config.h, not Kconfig: 460800 baud, 8N1, UART_HW_FLOWCTRL_DISABLE.
# They match the HA OTBR app with baudrate "460800" and flow_control: false.
CONFIG_OPENTHREAD_RCP_UART=y
